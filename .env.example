# vedrí funnel — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Everything ships SAFE: sending is off, and the system runs in shadow mode
# until you deliberately switch these.

# ─── Safety flags (leave as-is until a human decides otherwise) ──────────────
# DRY_RUN: everything computes; drafts are written to output/drafts/ as files,
# nothing is sent, and NO writes hit HubSpot. This is the Phase 9 shadow mode.
DRY_RUN=true
# AUTO_SEND_FOLLOWUPS: when false (day-one default), every outbound email is a
# Gmail draft that Daniel sends by hand. The auto-send path is built but OFF.
AUTO_SEND_FOLLOWUPS=false

# ─── Regional (matches the corrected HubSpot settings) ──────────────────────
TIMEZONE=Europe/London
CURRENCY=GBP

# ─── Mailboxes ──────────────────────────────────────────────────────────────
# Warm/inbound/hot — the primary studio inbox. Replies and warm leads only.
MAILBOX_WARM=info@vedri.studio
# Cold sending domain — separate, warmed 3-4 weeks, cold sequences only.
# Leave blank until the domain is bought and its DNS (SPF/DKIM/DMARC) is live.
MAILBOX_COLD=

# ─── cPanel mail (IMAP read + Drafts, SMTP send) for the warm inbox ─────────
MAIL_HOST=vedri.studio
MAIL_IMAP_PORT=993
MAIL_SMTP_PORT=465
MAIL_USER=info@vedri.studio
# The mailbox password. Sensitive — stays only in this gitignored file.
MAIL_PASS=
# Drafts folder path on the server (cPanel is usually INBOX.Drafts; run
# `pnpm run mail-doctor` and it'll tell you if it differs).
MAIL_DRAFTS_FOLDER=INBOX.Drafts
MAIL_FROM_NAME=vedrí

# ─── HubSpot (private app token) ────────────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=149092923

# ─── Google (Gmail + Calendar) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ─── Anthropic / Claude (copy generation + reply classification) ────────────
ANTHROPIC_API_KEY=
# Model used for copy + classification.
CLAUDE_MODEL=claude-sonnet-5

# ─── Sender identity + compliance footer (UK PECR: required in every email) ──
SENDER_NAME=Daniel Evans, vedrí
# The studio's registered postal address — REQUIRED before any email can send.
# Until set, drafts are generated but lint-blocked with a NEEDS_INPUT flag.
SENDER_POSTAL_ADDRESS=
UNSUBSCRIBE_MAILTO=info@vedri.studio
# Booking link offered as the call-to-action in copy (e.g. Cal.com/Calendly).
BOOKING_LINK=

# ─── Slack (alerts) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=#vedri-funnel
# Daniel's Slack user id for urgent DMs.
SLACK_URGENT_DM_USER=

# ─── Paths ──────────────────────────────────────────────────────────────────
DB_PATH=data/vedri-funnel.db
DRAFTS_DIR=output/drafts
LOG_DIR=output/logs
